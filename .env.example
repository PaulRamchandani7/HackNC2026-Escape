# API
PORT=8787
# InterVue calls https://emkc.org/api/v2/piston/execute from the browser.
# That public host is whitelist-only. Point this at a self-hosted Piston
# (`docker run --rm -p 2000:2000 ghcr.io/engineer-man/piston`) when you have one:
# PISTON_URL=http://127.0.0.1:2000/api/v2/execute
PISTON_URL=https://emkc.org/api/v2/piston/execute
PISTON_LANGUAGE=python3
PISTON_VERSION=3.10.0
# Set to true to fail closed when Piston rejects the run.
# PISTON_ONLY=true
PYTHON=python3

# Optional Supabase (schema in supabase/schema.sql). Local SQLite is the working store.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
DATABASE_PATH=./data/glitchlab.db
