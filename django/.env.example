# Copy to django/.env. The development server runs without this file.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional. Defaults to django/db.sqlite3.
# DJANGO_DB_PATH=
# Self-hosted Piston. The public emkc.org host is whitelist-only.
# Submitted code is sent here and is not executed by Django.
PISTON_URL=http://127.0.0.1:2000/api/v2/execute
PISTON_LANGUAGE=python3
PISTON_VERSION=3.10.0
